{
  "version": 2,
  "mise": {},
  "docker": {},
  "projects": [
    {
      "name": "myapp",
      "dir": "~/Projects/myapp/myapp-ops",
      "port": 8099,
      "toolchain": "mise",
      "commands": {
        "up": ["make", "start"],
        "restart": ["make", "restart-stack"],
        "down": ["make", "stop"]
      },
      "compose": ["myapp", "myapp-native-observability"],
      "links": [
        {"label": "App", "url": "http://localhost:3001"},
        {"label": "API docs", "url": "http://localhost:8001/docs"},
        {"label": "Grafana", "url": "http://localhost:3301"}
      ]
    }
  ]
}
